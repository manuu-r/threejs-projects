{
  "name": "threejs-fun",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["projects/*"],
  "scripts": {
    "dev:punch": "npm run dev --workspace=@threejs-fun/punch-power",
    "dev:memes": "npm run dev --workspace=@threejs-fun/interactable-memes",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
